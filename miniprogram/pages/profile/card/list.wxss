/* 我的会员卡 */
.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #7a8499;
  margin-bottom: 16rpx;
}

/* 卡面 */
.vip-card {
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 56, 0.12);
}

.vip-count {
  background: linear-gradient(135deg, #c8552f 0%, #e07a4f 100%);
}

.vip-period {
  background: linear-gradient(135deg, #2d6ca3 0%, #4a8fc7 100%);
}

.vip-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vip-name {
  font-size: 34rpx;
  font-weight: 600;
}

.vip-type {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
}

.vip-remain {
  font-size: 28rpx;
  margin-top: 20rpx;
  opacity: 0.92;
}

.vip-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* 历史卡 */
.his-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}

.his-main {
  display: flex;
  flex-direction: column;
}

.his-name {
  font-size: 30rpx;
  color: #1f2a38;
  font-weight: 500;
}

.his-meta {
  font-size: 24rpx;
  color: #98a2b3;
  margin-top: 8rpx;
}

.his-status {
  font-size: 26rpx;
  color: #98a2b3;
}

/* 空态 */
.empty-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}

.empty-text {
  font-size: 28rpx;
  color: #98a2b3;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 320rpx;
}

/* 购买入口 */
.buy-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}

.buy-entry-text {
  font-size: 30rpx;
  color: #1f2a38;
}

.buy-entry-arrow {
  font-size: 36rpx;
  color: #98a2b3;
}

.btn-primary {
  background: #c8552f;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.btn-primary::after {
  border: none;
}
