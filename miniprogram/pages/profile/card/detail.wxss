/* 会员卡详情 */
.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #7a8499;
  margin-bottom: 16rpx;
}

/* 卡面 */
.vip-card {
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 56, 0.12);
}

.vip-count {
  background: linear-gradient(135deg, #c8552f 0%, #e07a4f 100%);
}

.vip-period {
  background: linear-gradient(135deg, #2d6ca3 0%, #4a8fc7 100%);
}

.vip-disabled {
  background: linear-gradient(135deg, #98a2b3 0%, #b8c0cc 100%);
}

.vip-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vip-name {
  font-size: 34rpx;
  font-weight: 600;
}

.vip-type {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
}

.vip-remain {
  font-size: 28rpx;
  margin-top: 20rpx;
  opacity: 0.92;
}

.vip-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* 卡信息 */
.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #7a8499;
}

.value {
  font-size: 28rpx;
  color: #1f2a38;
}

.order-no {
  font-size: 24rpx;
  color: #7a8499;
}

/* 核销记录 */
.rec-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}

.rec-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.rec-title {
  font-size: 28rpx;
  color: #1f2a38;
}

.rec-time {
  font-size: 24rpx;
  color: #98a2b3;
  margin-top: 8rpx;
}

.rec-deduct {
  font-size: 28rpx;
  color: #c8552f;
  margin-left: 24rpx;
  flex-shrink: 0;
}

.rec-empty {
  justify-content: center;
}

/* 失效引导入口 */
.buy-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}

.buy-entry-text {
  font-size: 30rpx;
  color: #1f2a38;
}

.buy-entry-arrow {
  font-size: 36rpx;
  color: #98a2b3;
}
