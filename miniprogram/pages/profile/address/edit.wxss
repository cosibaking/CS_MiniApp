/* 编辑地址 */
.page {
  padding-bottom: 200rpx; /* 给底部固定保存栏留空间 */
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 2rpx solid #f2f4f7;
}

.form-row-last {
  border-bottom: none;
}

.form-label {
  flex-shrink: 0;
  width: 180rpx;
  font-size: 28rpx;
  color: #1f2a38;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2a38;
}

.form-picker {
  flex: 1;
  min-width: 0;
}

.picker-value {
  font-size: 28rpx;
  color: #1f2a38;
}

.picker-placeholder {
  color: #b0b8c1;
}

.arrow {
  flex-shrink: 0;
  color: #b0b8c1;
  font-size: 32rpx;
  margin-left: 12rpx;
}

.phone-tip {
  margin-top: 20rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #98a2b3;
  line-height: 1.6;
}

.delete-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #c8552f;
  background: #fff;
  border: none;
  padding: 0;
}

.delete-btn::after {
  border: none;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0;
}

.save-btn::after {
  border: none;
}
