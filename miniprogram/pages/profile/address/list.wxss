/* 收货地址 */
.addr-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}

.addr-main {
  padding-bottom: 24rpx;
}

.addr-line1 {
  display: flex;
  align-items: center;
}

.addr-receiver {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a38;
}

.addr-phone {
  font-size: 26rpx;
  color: #667085;
  margin-left: 16rpx;
}

.default-tag {
  margin-left: auto;
  font-size: 20rpx;
  color: #c8552f;
  background: #f9ede8;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.addr-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #5a6572;
  line-height: 1.6;
}

.addr-ops {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  border-top: 2rpx solid #f2f4f7;
  padding: 16rpx 0;
}

.op-btn {
  font-size: 24rpx;
  color: #8a94a0;
  padding: 8rpx 8rpx;
}

.op-edit {
  color: #c8552f;
}

.add-area {
  margin-top: 40rpx;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0;
}

.add-btn::after {
  border: none;
}
