<!--编辑地址：新增/编辑共用表单，地区选择器 + 设为默认；编辑态可删除-->
<view class="page">
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">收件人</text>
      <input class="form-input" value="{{receiver}}" maxlength="20" placeholder="请输入收件人姓名"
             bindinput="onReceiverInput" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" value="{{phone}}" maxlength="11"
             placeholder="{{phoneMasked || '请输入 11 位手机号'}}"
             bindinput="onPhoneInput" />
    </view>
    <view class="form-row">
      <text class="form-label">所在地区</text>
      <picker class="form-picker" mode="region" value="{{regionArr}}" bindchange="onRegionChange">
        <view class="picker-value {{region ? '' : 'picker-placeholder'}}">
          {{region || '请选择省 / 市 / 区'}}
        </view>
      </picker>
      <text class="arrow">›</text>
    </view>
    <view class="form-row">
      <text class="form-label">详细地址</text>
      <input class="form-input" value="{{detail}}" maxlength="100" placeholder="街道、门牌号等"
             bindinput="onDetailInput" />
    </view>
    <view class="form-row form-row-last">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{isDefault}}" color="#C8552F" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="phone-tip" wx:if="{{phoneMasked}}">原手机号 {{phoneMasked}}，如需修改请直接输入新号码，留空则保留原号</view>

  <button wx:if="{{!isNew}}" class="delete-btn" bindtap="onDelete">删除该地址</button>

  <!-- 底部保存栏 -->
  <view class="footer-bar">
    <button class="btn-primary save-btn" disabled="{{submitting}}" bindtap="onSave">
      {{submitting ? '保存中…' : '保存'}}
    </button>
  </view>
</view>
