/* 用户详情（资料卡 + 管理操作 + 会员卡 + 协议记录；与 refund-audit 同设计语言） */

.user-detail-page {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 空态/引导块（与 refund-audit 同结构） */
.empty-block {
  text-align: center;
  padding: 120rpx 32rpx 0;
}
.empty-emoji {
  font-size: 88rpx;
  line-height: 1;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5A6572;
}
.empty-btn {
  width: 320rpx;
  margin: 40rpx auto 0;
}
.empty-btn::after {
  border: none;
}

/* 白卡 */
.card {
  margin-top: 24rpx;
  padding: 8rpx 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.section-card {
  padding: 24rpx 32rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2A38;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F2F4;
}
.section-empty {
  padding: 40rpx 0 24rpx;
  font-size: 24rpx;
  color: #B0B8C1;
  text-align: center;
}

/* 资料卡头部 */
.profile-card {
  padding: 32rpx;
}
.profile-head {
  display: flex;
  align-items: center;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F0F2F4;
}
.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #C8552F;
  background: rgba(200, 85, 47, 0.08);
}
.profile-title {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2A38;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.minor-tag {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #B26B00;
  background: rgba(178, 107, 0, 0.08);
  border-radius: 8rpx;
  vertical-align: middle;
}
.profile-badges {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.role-badge {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #5A6572;
  background: #F0F2F4;
  border-radius: 8rpx;
}
.role-admin {
  color: #C8552F;
  background: rgba(200, 85, 47, 0.08);
}
.role-staff {
  color: #1E7F4F;
  background: rgba(30, 127, 79, 0.08);
}
.role-captain {
  color: #2C5FA8;
  background: rgba(44, 95, 168, 0.08);
}
.status-badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
  color: #5A6572;
  background: #F0F2F4;
}
.badge-normal {
  color: #1E7F4F;
  background: rgba(30, 127, 79, 0.08);
}
.badge-banned {
  color: #B03030;
  background: rgba(176, 48, 48, 0.08);
}
.badge-card-active {
  color: #1E7F4F;
  background: rgba(30, 127, 79, 0.08);
}
.badge-card-expired {
  color: #B26B00;
  background: rgba(178, 107, 0, 0.08);
}
.badge-card-voided {
  color: #B03030;
  background: rgba(176, 48, 48, 0.08);
}

/* 统计三列 */
.stat-row {
  display: flex;
  margin-top: 28rpx;
  padding: 20rpx 0;
  background: #F5F6F8;
  border-radius: 12rpx;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2A38;
}
.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8A94A0;
}

/* 资料信息行 */
.info-list {
  margin-top: 8rpx;
}
.info-row {
  display: flex;
  align-items: baseline;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0F2F4;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  flex-shrink: 0;
  width: 180rpx;
  font-size: 24rpx;
  color: #8A94A0;
}
.info-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #1F2A38;
  word-break: break-all;
}

/* 管理操作行 */
.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F2F4;
}
.action-row:last-of-type {
  border-bottom: none;
}
.action-label {
  font-size: 26rpx;
  color: #5A6572;
}
.btn-mini {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #C8552F;
  border: 1rpx solid rgba(200, 85, 47, 0.35);
  border-radius: 12rpx;
}
.btn-mini-danger {
  color: #B03030;
  border-color: rgba(176, 48, 48, 0.3);
}
.btn-mini-success {
  color: #1E7F4F;
  border-color: rgba(30, 127, 79, 0.3);
}

/* 人工开卡表单 */
.grant-form {
  margin-top: 8rpx;
  padding: 8rpx 0 24rpx;
  border-bottom: 1rpx solid #F0F2F4;
}
.form-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.form-label {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 24rpx;
  color: #5A6572;
}
.form-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1F2A38;
  background: #F5F6F8;
  border-radius: 10rpx;
}
.form-picker-value {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #1F2A38;
  background: #F5F6F8;
  border-radius: 10rpx;
}
.form-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #B0B8C1;
  line-height: 1.5;
}
.btn-submit {
  display: inline-block;
  margin-top: 24rpx;
  color: #FFFFFF;
  background: #C8552F;
  border-color: #C8552F;
}

/* 会员卡条目 */
.card-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F2F4;
}
.card-item:last-of-type {
  border-bottom: none;
}
.card-item-head {
  display: flex;
  align-items: center;
}
.card-item-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2A38;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.card-type-tag {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #5A6572;
  background: #F0F2F4;
  border-radius: 8rpx;
  vertical-align: middle;
}
.card-item-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8A94A0;
  word-break: break-all;
}
.card-item-remark {
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  font-size: 22rpx;
  color: #5A6572;
  background: #F5F6F8;
  border-radius: 10rpx;
  line-height: 1.5;
}
.card-item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.act-link {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  color: #5A6572;
  border: 1rpx solid #D8DCE1;
  border-radius: 10rpx;
}
.act-link + .act-link {
  margin-left: 12rpx;
}
.act-danger {
  color: #B03030;
  border-color: rgba(176, 48, 48, 0.3);
}
.act-primary {
  color: #C8552F;
  border-color: rgba(200, 85, 47, 0.35);
}

/* 协议签署记录 */
.waiver-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F2F4;
}
.waiver-row:last-of-type {
  border-bottom: none;
}
.waiver-main {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #1F2A38;
}
.waiver-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #8A94A0;
}
