/* 用户管理列表（筛选条 + 用户卡列表；与 refund-audit 同设计语言） */

.user-list-page {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 空态/引导块（与 refund-audit 同结构） */
.empty-block {
  text-align: center;
  padding: 120rpx 32rpx 0;
}
.empty-emoji {
  font-size: 88rpx;
  line-height: 1;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5A6572;
}
.empty-btn {
  width: 320rpx;
  margin: 40rpx auto 0;
}
.empty-btn::after {
  border: none;
}

/* 白卡 */
.card {
  margin-top: 24rpx;
  padding: 8rpx 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}

/* 筛选条：搜索框 + 下拉筛选 */
.filter-bar {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.search-box {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
}
.search-input {
  flex: 1;
  height: 68rpx;
  font-size: 26rpx;
  color: #1F2A38;
}
.search-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #C8552F;
  border-radius: 10rpx;
}
.filter-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.filter-picker {
  flex-shrink: 0;
}
.filter-value {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #5A6572;
  background: #F5F6F8;
  border-radius: 10rpx;
}
.filter-picker + .filter-picker {
  margin-left: 16rpx;
}
.filter-total {
  margin-left: auto;
  font-size: 22rpx;
  color: #8A94A0;
}

/* 用户条目 */
.user-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F2F4;
}
.user-row:last-of-type {
  border-bottom: none;
}
.row-head {
  display: flex;
  align-items: center;
}
.row-info {
  flex: 1;
  min-width: 0;
}
.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2A38;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.minor-tag {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #B26B00;
  background: rgba(178, 107, 0, 0.08);
  border-radius: 8rpx;
  vertical-align: middle;
}
.row-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A94A0;
}
.row-badges {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.role-badge {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #5A6572;
  background: #F0F2F4;
  border-radius: 8rpx;
}
.role-admin {
  color: #C8552F;
  background: rgba(200, 85, 47, 0.08);
}
.role-staff {
  color: #1E7F4F;
  background: rgba(30, 127, 79, 0.08);
}
.role-captain {
  color: #2C5FA8;
  background: rgba(44, 95, 168, 0.08);
}
.status-badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
  color: #5A6572;
  background: #F0F2F4;
}
.badge-normal {
  color: #1E7F4F;
  background: rgba(30, 127, 79, 0.08);
}
.badge-banned {
  color: #B03030;
  background: rgba(176, 48, 48, 0.08);
}
.row-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8A94A0;
  word-break: break-all;
}

/* 列表底部加载 */
.list-more {
  padding-top: 16rpx;
  font-size: 22rpx;
  color: #B0B8C1;
  text-align: center;
}
