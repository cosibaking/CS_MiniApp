/* Excel 导入页 — 对齐 admin 模块设计语言（基础容器 .page / .btn-primary 见 app.wxss） */
.import-page {
  padding-bottom: 48rpx;
}

.loading-tip {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8A94A0;
}

.empty-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx;
}

.empty-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8A94A0;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
  margin-bottom: 24rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2A38;
}

.tpl-btn {
  font-size: 26rpx;
  color: #C8552F;
  padding: 4rpx 12rpx;
}

/* 模板列说明 */
.tpl-tip {
  font-size: 24rpx;
  color: #8A94A0;
  padding: 12rpx 0 16rpx;
}

.col-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F2F4;
}

.col-row:last-child {
  border-bottom: none;
}

.col-tag {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  line-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: #5A6572;
  background: #F0F2F4;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.col-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.col-title {
  font-size: 28rpx;
  color: #1F2A38;
}

.col-req {
  font-size: 20rpx;
  color: #C8552F;
  background: rgba(200, 85, 47, 0.1);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 12rpx;
}

.col-desc {
  font-size: 24rpx;
  color: #8A94A0;
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0 8rpx;
}

.form-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #5A6572;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F2A38;
}

.input-ph {
  color: #B0B8C1;
}

.form-tip {
  font-size: 24rpx;
  color: #8A94A0;
  padding: 8rpx 0 24rpx;
}

/* 文件选择 */
.file-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
  border: 2rpx dashed #C4CBD3;
  border-radius: 12rpx;
  gap: 8rpx;
}

.file-picker-icon {
  font-size: 48rpx;
  color: #C8552F;
  line-height: 1;
}

.file-picker-text {
  font-size: 28rpx;
  color: #1F2A38;
}

.file-picker-sub {
  font-size: 24rpx;
  color: #8A94A0;
}

.file-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
}

.file-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.file-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.file-name {
  font-size: 28rpx;
  color: #1F2A38;
  word-break: break-all;
}

.file-size {
  font-size: 24rpx;
  color: #8A94A0;
}

.file-remove {
  font-size: 26rpx;
  color: #B03030;
  padding: 8rpx 16rpx;
}

.submit-btn {
  margin-top: 32rpx;
  width: 100%;
}

/* 结果页 */
.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F2F4;
}

.result-status {
  font-size: 34rpx;
  font-weight: 600;
}

.st-ok {
  color: #2E7D52;
}

.st-partial {
  color: #C8552F;
}

.st-fail {
  color: #B03030;
}

.result-id {
  font-size: 24rpx;
  color: #B0B8C1;
  word-break: break-all;
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

.result-counts {
  display: flex;
  padding: 28rpx 0 8rpx;
}

.count-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.count-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #1F2A38;
}

.count-ok {
  color: #2E7D52;
}

.count-fail {
  color: #B03030;
}

.count-label {
  font-size: 24rpx;
  color: #8A94A0;
}

.result-tip {
  font-size: 24rpx;
  color: #8A94A0;
  padding: 12rpx 0 8rpx;
  border-top: 1rpx solid #F0F2F4;
}

/* 失败明细 */
.fail-loading {
  padding: 24rpx 0 16rpx;
  font-size: 26rpx;
  color: #8A94A0;
}

.fail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F2F4;
  gap: 16rpx;
}

.fail-row:last-child {
  border-bottom: none;
}

.fail-line {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #C8552F;
  font-weight: 600;
}

.fail-reason {
  flex: 1;
  font-size: 26rpx;
  color: #5A6572;
  word-break: break-all;
}
