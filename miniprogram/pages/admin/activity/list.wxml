<!--活动管理列表：全状态筛选 + 搜索 + 发布/取消/编辑/名单入口-->
<view class="page">
  <block wx:if="{{noPermission}}">
    <view class="perm-box">
      <text class="perm-icon">🔒</text>
      <text class="perm-title">暂无权限</text>
      <text class="perm-desc">需要「发布活动」权限，请联系管理员开通</text>
    </view>
  </block>

  <block wx:else>
    <!-- 搜索栏 -->
    <view class="search-bar">
      <input class="search-input" placeholder="搜索活动标题" value="{{keyword}}"
        confirm-type="search" bindinput="onKeyword" bindconfirm="onSearch" />
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>

    <!-- 状态筛选 -->
    <scroll-view class="chips" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chips-row">
        <view wx:for="{{statusChips}}" wx:key="value"
          class="chip {{status === item.value ? 'chip-on' : ''}}"
          data-value="{{item.value}}" bindtap="onStatusTap">{{item.label}}</view>
      </view>
    </scroll-view>

    <!-- 统计条 -->
    <view class="stat-bar">
      <text class="stat-total">共 {{total}} 场活动</text>
    </view>

    <!-- 列表 -->
    <view class="card-list">
      <view wx:for="{{list}}" wx:key="id" class="card">
        <view class="card-head" bindtap="goDetail" data-id="{{item.id}}">
          <view class="card-title-row">
            <text class="card-title">{{item.title}}</text>
            <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <view class="card-meta">
            <text class="meta-line">{{item.typeLabel}}</text>
            <text class="meta-line">{{item.timeText}}</text>
            <text wx:if="{{item.deadlineText}}" class="meta-line warn">{{item.deadlineText}}</text>
          </view>
        </view>
        <view class="card-stat">
          <text class="stat-price">{{item.priceText}}</text>
          <text class="stat-count">{{item.statText}}</text>
        </view>
        <view class="card-actions">
          <view wx:if="{{item.canEdit}}" class="btn-mini btn-line" data-index="{{index}}" catchtap="goEdit">编辑</view>
          <view wx:if="{{item.canPublish}}" class="btn-mini btn-main" data-index="{{index}}" catchtap="onPublish">发布</view>
          <view wx:if="{{item.canViewDetail}}" class="btn-mini btn-line" data-index="{{index}}" catchtap="goEnrollList"
            data-id="{{item.id}}" data-title="{{item.title}}">名单</view>
          <view wx:if="{{item.canViewDetail}}" class="btn-mini btn-plain" data-index="{{index}}" catchtap="goDetail"
            data-id="{{item.id}}">详情</view>
          <view wx:if="{{item.canCancel}}" class="btn-mini btn-danger" data-index="{{index}}" catchtap="onCancel">取消</view>
        </view>
      </view>
    </view>

    <!-- 空态 / 加载提示 -->
    <view wx:if="{{empty}}" class="empty">
      <text class="empty-icon">📋</text>
      <text class="empty-title">暂无活动</text>
      <text class="empty-desc">点击右下角按钮创建第一场活动</text>
    </view>
    <view wx:if="{{loading}}" class="load-tip">加载中...</view>
    <view wx:elif="{{finished && list.length > 0}}" class="load-tip">— 没有更多了 —</view>

    <!-- 新建活动 FAB -->
    <view class="fab" bindtap="goCreate">＋ 新建</view>
  </block>
</view>
