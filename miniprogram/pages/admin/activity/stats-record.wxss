/* 战绩录入 — 与管理页同一套设计令牌 */
page {
  background: #F5F6F8;
  font-size: 28rpx;
  color: #1F2A38;
}

.page {
  padding: 20rpx 24rpx 60rpx;
}

/* 无权限 */
.perm-box {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.perm-icon { font-size: 88rpx; }
.perm-title { margin-top: 24rpx; font-size: 32rpx; font-weight: 600; }
.perm-desc { margin-top: 12rpx; font-size: 26rpx; color: #8A94A0; }

/* 卡片 */
.card {
  margin-top: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* 选人 picker */
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.picker-on {
  background: rgba(200, 85, 47, 0.08);
  color: #C8552F;
  font-weight: 500;
}
.picker.disabled {
  opacity: 0.7;
}
.placeholder {
  color: #8A94A0;
}
.picker-arrow {
  font-size: 32rpx;
  color: #8A94A0;
}

/* 表单字段 */
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F2F4;
}
.field.last {
  border-bottom: none;
}
.field-label {
  font-size: 28rpx;
  color: #5A6572;
}
.field-input {
  width: 200rpx;
  padding: 12rpx 20rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 500;
}

/* 胜负切换 */
.win-toggle {
  display: flex;
  background: #F0F2F4;
  border-radius: 12rpx;
  overflow: hidden;
}
.win-btn {
  padding: 12rpx 48rpx;
  font-size: 28rpx;
  color: #5A6572;
}
.win-btn.win-on {
  background: #2E7D5B;
  color: #FFFFFF;
  font-weight: 500;
}
.win-btn.lose-on {
  background: #B03030;
  color: #FFFFFF;
  font-weight: 500;
}
.field-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8A94A0;
  line-height: 1.6;
}

/* 提交 */
.submit-btn {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #C8552F;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}
.submit-btn.btn-busy {
  opacity: 0.5;
}

/* 批量导入入口 */
.import-card {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.import-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}
.import-title {
  font-size: 28rpx;
  font-weight: 600;
}
.import-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A94A0;
}
.import-arrow {
  font-size: 40rpx;
  color: #8A94A0;
}
