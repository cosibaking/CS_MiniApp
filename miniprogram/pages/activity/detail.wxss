/* pages/activity/detail.wxss — 复用 app.wxss 的 .page / 设计令牌 */
.page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }

.loading-tip { padding: 240rpx 0; text-align: center; font-size: 26rpx; color: #8A94A0; }

/* 封面 */
.cover { display: block; width: 100%; height: 420rpx; background: #E9EDF2; }

/* 标题区 */
.head { background: #fff; padding: 28rpx 32rpx; margin-bottom: 20rpx; }
.title-row { display: flex; align-items: flex-start; }
.title { flex: 1; font-size: 34rpx; font-weight: 600; color: #1F2A38; line-height: 1.45; }
.status { flex-shrink: 0; margin-left: 16rpx; font-size: 22rpx; line-height: 1; padding: 8rpx 14rpx; border-radius: 8rpx; }
.st-green { color: #2E7D5B; background: rgba(46, 125, 91, 0.12); }
.st-blue { color: #2D6CA3; background: rgba(45, 108, 163, 0.12); }
.st-red { color: #B03030; background: rgba(176, 48, 48, 0.12); }
.st-grey { color: #8A94A0; background: #F0F2F4; }
.type-tag { display: inline-block; margin-top: 16rpx; font-size: 22rpx; color: #C8552F; background: rgba(200, 85, 47, 0.1); padding: 6rpx 16rpx; border-radius: 8rpx; }

/* 已取消横幅 */
.cancel-banner { background: #fff; border: 1rpx solid rgba(176, 48, 48, 0.25); border-radius: 16rpx; margin: 0 24rpx 20rpx; padding: 24rpx 28rpx; }
.cancel-title { font-size: 28rpx; font-weight: 600; color: #B03030; }
.cancel-reason { margin-top: 12rpx; font-size: 24rpx; color: #5A6572; line-height: 1.5; }
.cancel-tip { margin-top: 16rpx; font-size: 22rpx; color: #B03030; background: rgba(176, 48, 48, 0.06); border-radius: 8rpx; padding: 12rpx 16rpx; line-height: 1.5; }

/* 信息卡 */
.card { background: #fff; border-radius: 16rpx; margin: 0 24rpx 20rpx; padding: 8rpx 28rpx; box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06); }
.row { display: flex; padding: 22rpx 0; border-bottom: 1rpx solid #F0F2F4; }
.row:last-child { border-bottom: none; }
.row-label { flex-shrink: 0; width: 140rpx; font-size: 26rpx; color: #8A94A0; }
.row-value { flex: 1; font-size: 26rpx; color: #1F2A38; line-height: 1.5; }
.row-value.price { color: #C8552F; font-weight: 600; }

/* 报名进度 */
.progress { height: 12rpx; background: #F0F2F4; border-radius: 6rpx; overflow: hidden; margin: 8rpx 0 24rpx; }
.progress-bar { height: 100%; background: #C8552F; border-radius: 6rpx; }
.waitlist-tip { margin: 0 0 24rpx; font-size: 22rpx; color: #8A6D1F; background: rgba(138, 109, 31, 0.08); border-radius: 8rpx; padding: 14rpx 18rpx; line-height: 1.5; }

/* 卡片标题 */
.card-title { font-size: 28rpx; font-weight: 600; color: #1F2A38; padding: 24rpx 0 16rpx; }
.title-sub { margin-left: 12rpx; font-size: 22rpx; font-weight: 400; color: #8A94A0; }

/* 本场战绩：荣誉名单 + 击杀榜（§5.1.2 ③） */
.honor-lines { padding-bottom: 8rpx; }
.honor-line { display: flex; align-items: flex-start; padding: 10rpx 0; }
.honor-tag { flex-shrink: 0; font-size: 20rpx; line-height: 1; padding: 6rpx 14rpx; border-radius: 6rpx; margin-right: 16rpx; }
.h-mvp { color: #8A6D1F; background: rgba(217, 164, 65, 0.18); }
.h-svp { color: #5A6572; background: #EEF1F4; }
.h-best_heal { color: #2E7D5B; background: rgba(46, 125, 91, 0.12); }
.h-best_supply { color: #2D6CA3; background: rgba(45, 108, 163, 0.12); }
.h-best_capture { color: #C8552F; background: rgba(200, 85, 47, 0.1); }
.honor-names { flex: 1; font-size: 24rpx; color: #1F2A38; line-height: 1.6; }
.kill-board { border-top: 1rpx solid #F0F2F4; margin-top: 8rpx; padding-bottom: 16rpx; }
.kill-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #F7F8FA; }
.kill-row:last-child { border-bottom: none; }
.kb-rank { flex-shrink: 0; width: 44rpx; font-size: 26rpx; font-weight: 600; color: #8A94A0; }
.kb-top { color: #C8552F; }
.kb-name { flex: 1; font-size: 26rpx; color: #1F2A38; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 12rpx; }
.kb-tag { flex-shrink: 0; font-size: 20rpx; line-height: 1; padding: 5rpx 10rpx; border-radius: 6rpx; margin-right: 16rpx; }
.kb-win { color: #2E7D5B; background: rgba(46, 125, 91, 0.12); }
.kb-lose { color: #8A94A0; background: #F0F2F4; }
.kb-kills { flex-shrink: 0; font-size: 24rpx; color: #5A6572; }

/* 评价摘要 */
.review-summary { display: flex; align-items: center; padding-bottom: 24rpx; }
.stars { font-size: 32rpx; color: #C8552F; font-weight: 600; margin-right: 16rpx; }
.review-count { font-size: 24rpx; color: #8A94A0; }
.empty-tip { font-size: 24rpx; color: #8A94A0; padding-bottom: 24rpx; }

/* 相册入口 */
.link-card { display: flex; align-items: center; justify-content: space-between; padding-right: 28rpx; }
.link-card .card-title { flex: 1; padding-bottom: 24rpx; }
.link-right { display: flex; align-items: center; }
.link-sub { font-size: 24rpx; color: #8A94A0; }
.arrow { margin-left: 8rpx; font-size: 32rpx; color: #C4CBD4; line-height: 1; }

/* 活动介绍 */
.intro { display: block; font-size: 26rpx; color: #5A6572; line-height: 1.7; white-space: pre-line; word-break: break-all; padding-bottom: 24rpx; }

/* 底部操作栏 */
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(31, 42, 56, 0.08); padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; }
.bottom-price { flex: 1; display: flex; flex-direction: column; }
.bottom-price .price { font-size: 32rpx; font-weight: 600; color: #C8552F; }
.min-tip { margin-top: 4rpx; font-size: 20rpx; color: #8A94A0; }

.btn-share { flex-shrink: 0; width: 104rpx; height: 80rpx; line-height: 80rpx; margin: 0 16rpx 0 0; padding: 0; font-size: 24rpx; color: #5A6572; background: #F5F6F8; border-radius: 12rpx; border: none; }
.btn-share::after { border: none; }

.btn-main { flex-shrink: 0; width: 260rpx; height: 80rpx; line-height: 80rpx; padding: 0; font-size: 28rpx; font-weight: 600; color: #fff; background: #C8552F; border-radius: 12rpx; border: none; }
.btn-main::after { border: none; }
.btn-main.btn-disabled { background: #D5DBE1; }

.btn-team { flex-shrink: 0; height: 80rpx; line-height: 80rpx; margin-right: 16rpx; padding: 0 24rpx; font-size: 24rpx; color: #C8552F; background: #F9EDE8; border-radius: 12rpx; border: none; }
.btn-team::after { border: none; }
