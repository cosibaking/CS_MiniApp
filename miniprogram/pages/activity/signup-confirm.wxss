/* pages/activity/signup-confirm.wxss — 复用 app.wxss 的 .page / 设计令牌 */
.page { padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom)); }

.loading-tip { padding: 240rpx 0; text-align: center; font-size: 26rpx; color: #8A94A0; }

.card { background: #fff; border-radius: 16rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06); }
.card-title { font-size: 28rpx; font-weight: 600; color: #1F2A38; margin-bottom: 8rpx; }

/* 活动快照 */
.act-brief { display: flex; align-items: center; }
.brief-cover { flex-shrink: 0; width: 160rpx; height: 120rpx; border-radius: 12rpx; background: #E9EDF2; margin-right: 20rpx; }
.brief-info { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.brief-title { font-size: 28rpx; font-weight: 600; color: #1F2A38; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.brief-time { margin-top: 8rpx; font-size: 22rpx; color: #8A94A0; }
.brief-venue { margin-top: 4rpx; font-size: 22rpx; color: #8A94A0; }

/* 前置项引导 */
.pre-card { display: flex; align-items: center; background: #FFF7EC; border: 1rpx solid rgba(200, 85, 47, 0.25); border-radius: 16rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx; }
.pre-text { flex: 1; display: flex; flex-direction: column; }
.pre-title { font-size: 26rpx; font-weight: 600; color: #8A4A1F; }
.pre-sub { margin-top: 6rpx; font-size: 22rpx; color: #A8785A; }
.pre-go { flex-shrink: 0; margin-left: 16rpx; font-size: 24rpx; font-weight: 600; color: #C8552F; }

/* 满员候补提示 */
.full-tip { font-size: 22rpx; color: #8A6D1F; background: rgba(138, 109, 31, 0.08); border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; line-height: 1.5; }

/* 费用明细 */
.fee-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; }
.fee-label { font-size: 26rpx; color: #5A6572; }
.fee-value { font-size: 26rpx; color: #1F2A38; }
.fee-value.discount { color: #2E7D5B; }
.fee-row.total { border-top: 1rpx solid #F0F2F4; margin-top: 8rpx; padding-top: 24rpx; }
.fee-value.total { font-size: 34rpx; font-weight: 600; color: #C8552F; }
.fee-note { font-size: 22rpx; color: #8A94A0; padding-top: 8rpx; }

/* 支付方式 */
.pay-options { display: flex; margin-top: 12rpx; }
.pay-option { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 20rpx 8rpx; border: 2rpx solid #F0F2F4; border-radius: 12rpx; margin-right: 16rpx; }
.pay-option:last-child { margin-right: 0; }
.pay-option.on { border-color: #C8552F; background: rgba(200, 85, 47, 0.05); }
.pay-label { font-size: 26rpx; font-weight: 600; color: #1F2A38; }
.pay-option.on .pay-label { color: #C8552F; }
.pay-desc { margin-top: 8rpx; font-size: 20rpx; color: #8A94A0; text-align: center; }

/* 协议勾选 */
.agree-row { display: flex; align-items: flex-start; padding: 8rpx; }
.agree-check { flex-shrink: 0; width: 34rpx; height: 34rpx; border-radius: 50%; border: 2rpx solid #C4CBD4; margin-right: 14rpx; font-size: 22rpx; color: #fff; text-align: center; line-height: 32rpx; overflow: hidden; }
.agree-check.on { background: #C8552F; border-color: #C8552F; }
.agree-text { flex: 1; font-size: 24rpx; color: #5A6572; line-height: 1.6; }
.agree-link { color: #C8552F; }

/* 底部提交 */
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(31, 42, 56, 0.08); padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; }
.bottom-price { flex: 1; display: flex; align-items: baseline; }
.bottom-price .label { font-size: 24rpx; color: #8A94A0; margin-right: 10rpx; }
.bottom-price .price { font-size: 36rpx; font-weight: 600; color: #C8552F; }

.btn-main { flex-shrink: 0; width: 280rpx; height: 80rpx; line-height: 80rpx; padding: 0; font-size: 28rpx; font-weight: 600; color: #fff; background: #C8552F; border-radius: 12rpx; border: none; }
.btn-main::after { border: none; }
.btn-main[disabled] { background: #E3A086; color: #fff; }
