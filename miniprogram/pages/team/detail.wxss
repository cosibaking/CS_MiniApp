/* 战队主页（hero 深色卡 + 白卡分区 + 固定底部操作区） */

/* 底部固定操作区占位（.page padding 24rpx 基础上追加） */
.detail-page {
  padding-bottom: 180rpx;
}

/* 空态/引导块（复用 list 页空态结构） */
.empty-block {
  text-align: center;
  padding: 120rpx 32rpx 0;
}
.empty-emoji {
  font-size: 88rpx;
  line-height: 1;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5A6572;
}
.empty-btn {
  width: 320rpx;
  margin: 40rpx auto 0;
}
.empty-btn::after {
  border: none;
}

/* 审核中横幅（创建者视角，§2.2） */
.state-banner {
  padding: 24rpx 28rpx;
  background: rgba(200, 85, 47, 0.08);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.state-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C8552F;
}
.state-banner-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A94A0;
}

/* 被拒横幅 + 重提入口（R1） */
.reject-banner {
  padding: 24rpx 28rpx;
  background: rgba(200, 85, 47, 0.08);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.reject-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C8552F;
}
.reject-reason {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5A6572;
}
.reject-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #C8552F;
}

/* 战队信息 hero 卡（深色，与 list 置顶卡同语言） */
.hero-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #1F2A38;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 56, 0.25);
}
.hero-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.08);
}
.hero-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.hero-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hero-slogan {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hero-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* 白卡分区 */
.card {
  margin-top: 24rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2A38;
  margin-bottom: 20rpx;
}

/* 简介 */
.intro-text {
  font-size: 26rpx;
  color: #5A6572;
  line-height: 1.7;
}

/* 战绩统计 */
.stats-row {
  display: flex;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2A38;
}
.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A94A0;
}
.stats-empty {
  padding: 16rpx 0 8rpx;
  font-size: 24rpx;
  color: #8A94A0;
  text-align: center;
}

/* 成员列表 */
.member-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F2F4;
}
.member-row:last-of-type {
  border-bottom: none;
}
.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F5F6F8;
}
.member-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.member-name-line {
  display: flex;
  align-items: center;
}
.member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2A38;
  max-width: 320rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.member-role {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #C8552F;
  background: rgba(200, 85, 47, 0.12);
  border-radius: 8rpx;
  flex-shrink: 0;
}
.member-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A94A0;
}
.rank-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #3E6B96;
  background: rgba(62, 107, 150, 0.12);
  border-radius: 8rpx;
}
.members-more {
  padding-top: 16rpx;
  font-size: 22rpx;
  color: #B0B8C1;
  text-align: center;
}

/* 底部固定操作区（safe-area） */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.footer-btn {
  flex: 1;
  margin: 0 10rpx;
}
.footer-btn::after {
  border: none;
}
.footer-btn:first-child {
  margin-left: 0;
}
.footer-btn:last-child {
  margin-right: 0;
}

/* 次级按钮（白底灰字） */
.btn-plain {
  background: #FFFFFF;
  color: #5A6572;
  border: 1rpx solid #D8DCE1;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-plain[disabled] {
  background: #F5F6F8;
  color: #B0B8C1;
  border-color: #F0F2F4;
}
.quit-btn {
  color: #B03030;
  border-color: rgba(176, 48, 48, 0.3);
}
