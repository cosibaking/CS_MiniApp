/* 战队列表 — 搜索 + 创建入口 + 我的战队置顶卡 + 战队卡片流 */

.list-page {
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* 搜索 + 创建入口 */
.filter-bar {
  display: flex;
  align-items: center;
}
.search-box {
  flex: 1;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.search-input {
  font-size: 26rpx;
  height: 40rpx;
  line-height: 40rpx;
}
.search-ph {
  color: #B0B8C1;
}
.create-entry {
  flex-shrink: 0;
  margin-left: 16rpx;
  background: #C8552F;
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 15rpx 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(200, 85, 47, 0.25);
}

/* 我的战队置顶卡（深色卡，与普通卡片区分） */
.my-team-card {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  background: #1F2A38;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 56, 0.25);
}
.my-team-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #2A3648;
}
.my-team-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.my-team-name-row {
  display: flex;
  align-items: center;
}
.my-team-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #E8A87C;
  background: rgba(232, 168, 124, 0.15);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}
.my-team-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.my-team-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}
.my-team-manage {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

/* 空态（含未登录引导） */
.empty-block {
  text-align: center;
  padding: 120rpx 0 60rpx;
}
.empty-emoji {
  font-size: 88rpx;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5A6572;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8A94A0;
}
.empty-btn {
  margin: 32rpx auto 0;
  width: 320rpx;
}
.empty-btn::after {
  border: none;
}
.empty-btn-plain {
  margin: 32rpx auto 0;
  width: 320rpx;
  background: #FFFFFF;
  color: #5A6572;
  font-size: 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.empty-btn-plain::after {
  border: none;
}

/* 战队卡片 */
.team-list {
  margin-top: 20rpx;
}
.team-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.team-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F2F4;
}
.team-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.team-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2A38;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-slogan {
  font-size: 24rpx;
  color: #5A6572;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.team-count {
  font-size: 24rpx;
  color: #5A6572;
}
.team-winrate {
  font-size: 22rpx;
  color: #2E7D5B;
  background: rgba(46, 125, 91, 0.12);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
