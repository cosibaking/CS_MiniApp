/* 邀请队员 — 搜索栏 + 结果列表（§2.2 禁选标注） */

.invite-page {
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* 搜索栏（昵称 / 手机号） */
.filter-bar {
  display: flex;
  align-items: center;
}
.search-box {
  flex: 1;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.search-input {
  font-size: 26rpx;
  height: 40rpx;
  line-height: 40rpx;
}
.search-ph {
  color: #B0B8C1;
}
.search-entry {
  flex-shrink: 0;
  margin-left: 16rpx;
  background: #C8552F;
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 15rpx 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(200, 85, 47, 0.25);
}

/* 空态（含未登录引导） */
.empty-block {
  text-align: center;
  padding: 120rpx 0 60rpx;
}
.empty-emoji {
  font-size: 88rpx;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5A6572;
}
.empty-btn {
  margin: 32rpx auto 0;
  width: 320rpx;
}
.empty-btn::after {
  border: none;
}
.empty-btn-plain {
  margin: 32rpx auto 0;
  width: 320rpx;
  background: #FFFFFF;
  color: #5A6572;
  font-size: 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.empty-btn-plain::after {
  border: none;
}

/* 结果列表 */
.result-card {
  margin-top: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.member-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.member-row + .member-row {
  border-top: 1rpx solid #F0F2F4;
}
.row-disabled {
  opacity: 0.6;
}
.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F0F2F4;
}
.member-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.member-name-line {
  display: flex;
  align-items: center;
}
.member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2A38;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
}
.phone-text {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #8A94A0;
}
.member-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A94A0;
}
.sub-tip {
  color: #B03030;
}
.apply-fail {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B03030;
}
.member-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}
.act-link {
  font-size: 24rpx;
  color: #5A6572;
  border: 1rpx solid #D8DCE1;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}
.act-link.act-primary {
  color: #C8552F;
  border-color: rgba(200, 85, 47, 0.4);
}
.act-link.act-disabled {
  color: #B0B8C1;
  border-color: #E4E7EB;
}

/* 列表底注 */
.list-more {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #B0B8C1;
}
