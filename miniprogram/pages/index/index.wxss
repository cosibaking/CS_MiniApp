/* 首页 — 品牌 Hero + 快捷宫格 + 近期活动卡片（卡片样式与活动 tab 同源） */

.index-page {
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 品牌 Hero（与导航栏 #1F2A38 同色系） */
.hero {
  background: linear-gradient(135deg, #1F2A38 0%, #2D3E52 100%);
  padding: 48rpx 32rpx 56rpx;
  color: #FFFFFF;
}
.hero-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-slogan {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.body {
  padding: 24rpx;
  margin-top: -24rpx;
}

/* 快捷入口宫格 */
.quick-grid {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.quick-item {
  flex: 1;
  text-align: center;
}
.quick-icon {
  font-size: 48rpx;
  line-height: 1.2;
}
.quick-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5A6572;
}
.quick-item:active {
  opacity: 0.7;
}

/* 板块标题行 */
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 4rpx 20rpx;
}
.sec-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2A38;
}
.sec-more {
  font-size: 24rpx;
  color: #8A94A0;
}

/* 空态 */
.empty-block {
  text-align: center;
  padding: 80rpx 0 60rpx;
}
.empty-emoji {
  font-size: 80rpx;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5A6572;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8A94A0;
}

/* 活动卡片（与 pages/activity/list.wxss 同源） */
.act-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 56, 0.06);
}
.act-cover {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F2F4;
}
.act-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.act-title-row {
  display: flex;
  align-items: flex-start;
}
.act-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #C8552F;
  background: rgba(200, 85, 47, 0.1);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
}
.type-novice { color: #2E7D5B; background: rgba(46, 125, 91, 0.12); }
.type-regular { color: #C8552F; background: rgba(200, 85, 47, 0.1); }
.type-theme { color: #7B4FBF; background: rgba(123, 79, 191, 0.12); }
.type-league { color: #2D6CA3; background: rgba(45, 108, 163, 0.12); }
.type-custom { color: #8A6D1F; background: rgba(138, 109, 31, 0.12); }
.act-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2A38;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.act-time {
  font-size: 24rpx;
  color: #5A6572;
  margin-top: 8rpx;
}
.act-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.act-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #C8552F;
}
.act-badge {
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.badge-remain {
  color: #2E7D5B;
  background: rgba(46, 125, 91, 0.12);
}
.badge-full {
  color: #B03030;
  background: rgba(176, 48, 48, 0.1);
}
.badge-ongoing {
  color: #2D6CA3;
  background: rgba(45, 108, 163, 0.12);
}
